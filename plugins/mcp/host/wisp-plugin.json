{
  "wispPlugin": 1,
  "id": "wisp.mcp",
  "name": "MCP server",
  "version": "1.0.0-alpha.14",
  "api": "^1",
  "description": "wisp.mcp host: the MCP server for agents and editors over POST /api/mcp and stdio, each tool a kernel command",
  "server": {
    "builtin": "wisp-mcp"
  },
  "permissions": [
    "automations:read",
    "automations:write",
    "automations:run",
    "channels:status",
    "channels:view",
    "channels:test",
    "channels:setup",
    "channels:update",
    "channels:refresh",
    "channels:extra",
    "connectors:*",
    "crew:*",
    "events:tail",
    "events:why",
    "factory:*",
    "goal:*",
    "later:*",
    "machines:*",
    "plugins:*",
    "resources:read",
    "resources:overlay",
    "runtime:*",
    "settings:read",
    "settings:write",
    "ship:*",
    "stuff:*",
    "telemetry:track",
    "threads:read",
    "threads:write",
    "watch:*",
    "worktrees:*"
  ],
  "activation": [
    "onStartup"
  ],
  "contributes": {
    "events": ["mcp.ask.closed", "mcp.ask.shown"],
    "commands": [
      {
        "id": "mcp.rpc",
        "title": "One MCP JSON-RPC message"
      },
      {
        "id": "mcp.tools",
        "title": "The MCP tools this caller is offered",
        "readOnly": true
      },
      {
        "id": "mcp.session.set",
        "title": "What a session's run is, for its tools"
      }
    ]
  }
}
