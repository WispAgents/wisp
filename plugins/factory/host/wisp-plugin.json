{
  "wispPlugin": 1,
  "id": "wisp.factory",
  "name": "Factories",
  "version": "1.0.0-alpha.5",
  "api": "^1",
  "description": "software factories: a task through stations (spec you approve, build, checks that are commands, review by a vote, ship a PR you merge), looped back to build with a limit (ADR-0114)",
  "kind": "plugin",
  "server": {
    "builtin": "wisp_factory"
  },
  "permissions": [
    "runtime:create",
    "runtime:get",
    "runtime:turns",
    "runtime:stop",
    "runtime:delete",
    "runtime:followUp",
    "runtime:ask",
    "runtime:pollAnswer",
    "runtime:unask",
    "runtime:setExt",
    "runtime:setState",
    "runtime:slots",
    "runtime:queue.cancel",
    "resources:read",
    "ship:ship",
    "ship:merge",
    "worktrees:remove",
    "proc:exec{bin:sh}",
    "store:write{owner:factory}"
  ],
  "activation": ["onStartup"],
  "requires": { "wisp.runtime": "^1.0.0-0" },
  "contributes": {
    "commands": [
      { "id": "factory.list", "title": "Factories (declared)", "readOnly": true },
      { "id": "factory.names", "title": "Factories a task can run through", "readOnly": true },
      { "id": "factory.set", "title": "Add or change a factory" },
      { "id": "factory.remove", "title": "Remove a factory" },
      { "id": "factory.stop", "title": "Stop a factory run" }
    ]
  }
}
