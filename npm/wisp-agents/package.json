{
  "name": "wisp-agents",
  "version": "1.0.0-alpha.16",
  "description": "Wisp Agents: your coding agents, as code. Runs Claude Code, Codex, Cursor and every other coding agent from one file in your repo, and keeps every task next to the code it wrote.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WispAgents/wisp.git",
    "directory": "npm/wisp-agents"
  },
  "homepage": "https://trywisp.dev/",
  "keywords": [
    "wisp-agents",
    "wisp",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "agent-orchestration",
    "git-worktree",
    "mcp",
    "cli",
    "tui"
  ],
  "bugs": "https://github.com/WispAgents/wisp/issues",
  "type": "module",
  "bin": {
    "wisp": "bin/wisp.js"
  },
  "exports": {
    ".": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./client.d.ts",
  "files": [
    "bin",
    "lib",
    "web",
    "client.js",
    "client.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "wisp-agents-darwin-arm64": "npm:wisp-agents@1.0.0-alpha.16-darwin-arm64",
    "wisp-agents-darwin-x64": "npm:wisp-agents@1.0.0-alpha.16-darwin-x64",
    "wisp-agents-linux-x64": "npm:wisp-agents@1.0.0-alpha.16-linux-x64",
    "wisp-agents-linux-arm64": "npm:wisp-agents@1.0.0-alpha.16-linux-arm64",
    "wisp-agents-linux-arm": "npm:wisp-agents@1.0.0-alpha.16-linux-arm",
    "wisp-agents-win32-x64": "npm:wisp-agents@1.0.0-alpha.16-win32-x64",
    "wisp-agents-win32-arm64": "npm:wisp-agents@1.0.0-alpha.16-win32-arm64"
  }
}
