import { computed, type PluginClient, type Readable } from '@wisp/client';
export function crewOf(c: PluginClient): Readable<readonly { id: string; name: string }[]> {
  return c.entities.list('crew');
}
export const memberOf = (c: PluginClient, id: string) => crewOf(c)().find((m) => m.id === id);
export function fromRow(c: PluginClient, key: string) {
  const row = c.entities.row<{ value: unknown }>('setting', key);
  return { value: computed(() => row()?.value), set: (_v: unknown) => undefined };
}
export function hasAny(c: PluginClient): () => boolean {
  const keys = c.entities.keys('crew');
  return () => keys().length > 0;
}
