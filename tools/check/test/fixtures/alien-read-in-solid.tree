import { createEffect, createMemo, on } from 'solid-js';
import { computed, family, type PluginClient } from '@wisp/client';
import { useShell } from '@wisp/shell';
import { crewOf, fromRow, hasAny, memberOf } from './data.ts';
interface Source { readonly value: Readable<boolean>; set(v: boolean): void }
export function Bad(props: { c: PluginClient; k: string; src: Source }) {
  const c = props.c;
  const shell = useShell();
  const rows = createMemo(() => [props.k].map((k) => c.entities.row(k, k)()));
  const total = computed(() => rows().length);
  createEffect(() => console.log(total()));
  const who = createMemo(() => memberOf(c, props.k)?.name);
  const spare = fromRow(c, 'spare');
  const on1 = createMemo(() => spare.value());
  const has = hasAny(c);
  const settings = c.settings([]);
  const theme = createMemo(() => settings.get('theme')());
  const byKey = family((k: string) => c.entities.row('x', k));
  createEffect(on(() => c.entities.keys('crew')(), () => undefined));
  const titled = createMemo(() => group({ title: (id: string) => crewOf(c)().find((m) => m.id === id)?.name }));
  // check:allow alien-read-in-solid
  const noReason = createMemo(() => c.entities.list('crew')());
  return (
    <div>
      {shell.nav().main.kind}
      {shell.selection.get()}
      {has() ? 'some' : 'none'}
      {byKey(props.k)()}
      {props.src.value() ? 'on' : 'off'}
    </div>
  );
}
