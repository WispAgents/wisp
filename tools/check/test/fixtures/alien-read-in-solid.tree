import { createEffect, createMemo, createSignal, on, onMount } from 'solid-js';
import { computed, untracked, type PluginClient } from '@wisp/client';
import { useDerived, useSignal } from '@wisp/ui';
import { useShell } from '@wisp/shell';
interface Mic { readonly on: () => boolean }
interface Lit { readonly on: Readable<boolean> }
interface SettingSource { readonly value: Readable<string> }
function outer(c: PluginClient, p: string) {
  const where = c.peers.status(p);
  return where;
}
export function Good(props: { c: PluginClient; k: string; mic: Mic }) {
  const c = props.c;
  const shell = useShell();
  const row = useSignal(c.entities.row('session', props.k));
  const rows = useDerived(() => c.entities.list('session')());
  const nav = useSignal(shell.nav);
  const total = computed(() => c.entities.list('session')().length);
  const [where] = createSignal('here');
  const place = createMemo(() => where());
  onMount(() => console.log(c.entities.keys('session')()));
  createEffect(on(row, () => console.log(shell.nav().side, untracked(shell.nav))));
  setTimeout(() => c.entities.pending()(), 0);
  // check:allow alien-read-in-solid read once on purpose: the size the dialog opens at
  const first = createMemo(() => c.entities.keys('session')().length);
  return (
    <div onClick={() => console.log(c.entities.row('session', props.k)())}>
      {row()?.title}
      {rows().length}
      {nav().main.kind}
      {place()}
      {props.mic.on() ? 'mic' : ''}
      <Setting source={{ value: () => shell.theme.pref(), set: () => undefined }} />
    </div>
  );
}
